matches the snapshot:
  1: |
    apiVersion: gateway.networking.k8s.io/v1
    kind: HTTPRoute
    metadata:
      name: RELEASE-NAME-iam-ui
      namespace: NAMESPACE
    spec:
      parentRefs:
        - name: k8sapi-gateway
      rules:
        - backendRefs:
            - name: RELEASE-NAME-iam-ui
              namespace: NAMESPACE
              port: 8080
          filters:
            - cors:
                allowCredentials: true
                allowHeaders:
                  - '*'
                allowMethods:
                  - GET
                  - OPTIONS
                  - POST
                maxAge: 100
              type: CORS
          matches:
            - path:
                type: PathPrefix
                value: /ui/iam
